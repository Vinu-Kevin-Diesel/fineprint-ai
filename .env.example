# ---- FinePrint configuration ----
# Copy this file to ".env" and fill in your key.

# === Local dev (easiest): a free Gemini API key from https://aistudio.google.com/apikey ===
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-2.5-flash

# === Production on GCP (Cloud Run + Vertex AI): set USE_VERTEX=true instead of a key ===
# When true, the app authenticates via Application Default Credentials (gcloud / the Cloud Run service account).
USE_VERTEX=false
GCP_PROJECT=
GCP_LOCATION=us-central1
