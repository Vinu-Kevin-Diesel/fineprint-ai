# ---- FinePrint configuration ----
# Copy this file to ".env" and fill in your key.

# === Reasoning provider: "gemini" (default) or "openai_compatible" (NIM / Groq / vLLM / OpenAI) ===
LLM_PROVIDER=gemini

# --- Gemini provider (also used for OCR of scanned docs regardless of LLM_PROVIDER) ---
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-2.5-flash-lite

# --- OpenAI-compatible provider (set LLM_PROVIDER=openai_compatible to use) ---
# NVIDIA NIM:  base_url https://integrate.api.nvidia.com/v1, key nvapi-... (https://build.nvidia.com)
# Groq:        base_url https://api.groq.com/openai/v1,       key gsk_...  (https://console.groq.com)
# Local vLLM:  base_url http://localhost:8000/v1,             key (any non-empty string)
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=nvapi-your-key-here
LLM_MODEL=meta/llama-3.3-70b-instruct

# === Production on GCP (Cloud Run + Vertex AI for Gemini): set USE_VERTEX=true instead of a key ===
USE_VERTEX=false
GCP_PROJECT=
GCP_LOCATION=us-central1

# === OCR backend for scanned PDFs/images: "gemini" (default) or "tesseract" ===
OCR_BACKEND=gemini
